# Go build outputs
/weir
/bin/
*.exe
*.test
*.out

# Editor / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Ephemeral mining artifacts (regenerable; large)
/tmp/

# Anthropic API key file — keep out of git
.env
.envrc

# tldr-pages clone used by build-idioms (regenerable)
/tldr/

# Eval cache (deterministic API responses keyed by content hash;
# regenerable, sometimes large)
/data/eval/cache/

# Settings backups (weir creates these; commit none)
*.weir-bak-*

# defn's per-project DB (unrelated tool)
.defn/

# Python bytecode cache
__pycache__/
*.pyc

# Personal project journal — stays in working dir, never committed.
# Was tracked in early commits; will drop out at squash-before-public time.
/SESSION.md

# Inbound field reports from sibling sessions. These are the raw source for
# rule changes and they are dense with private paths — the host's real
# home directory, checkout locations for projects unrelated to weir, and
# the occasional second account. The repo is public; the reports stay local.
# What survives into git is the rule, its test fixtures, and the CHANGELOG
# entry, all written with placeholder paths.
/FIELD_REPORT_*.md
/GOTCHA-*.md

# Same idea, same reason -- a working analysis that fed a rule or a CI
# decision. Once the rule/job exists and CHANGELOG.md summarizes why, the
# full scan or audit journal is scratch, not a public reference doc.
/data/FLAG-OVERLAP-REVIEW.md
/data/MACOS-COMPAT-AUDIT.md
/data/flag_overlap_report.json
